{
	"name": "clearcom-freespeakii",
	"version": "0.3.0",
	"description": "Bitfocus Companion module for Clear-Com Arcadia Central Station and FreeSpeak II base stations",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build && node tools/dev-layout.mjs",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"sim:arcadia": "node tools/simulator/simulator.mjs --mode arcadia --port 8080",
		"sim:fsii": "node tools/simulator/simulator.mjs --mode fsii --port 8081"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-clearcom-freespeakii.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "2.2.1",
		"socket.io-client": "2.5.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^22.19.17",
		"@types/socket.io-client": "1",
		"eslint": "^10.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"socket.io": "2.5.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0",
		"vitest": "^4.0.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.17.0"
}
